# Dependencies (پکیج‌های نود)
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output (فایل‌های بیلد و کش سرور)
/.next/
/out/

# Production Build Logs
build/
dist/

# Environment Variables (فایل‌های حساس و متغیرهای محیطی)
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel deployment cache
.vercel

# TypeScript & Next.js cache
*.tsbuildinfo
next-env.d.ts

# Operating System Files (فایل‌های اضافی ویندوز و مک)
.DS_Store
*.pem
Thumbs.db

# IDE & Editor files (تنظیمات ادیتور)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
